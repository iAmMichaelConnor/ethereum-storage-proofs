#[test]
fn event_typed_2() {
    let (claim, count, leaf, leaf_length, nodes, data) = case_event_typed_2();
    let (claim, count, leaf, leaf_length, nodes, data) =
        black_box((claim, count, leaf, leaf_length, nodes, data));
    let result = event(claim, count, leaf, leaf_length, nodes, data);
    let _ = result;
}

#[test(should_fail_with = "Node hash differs from its parent reference")]
fn receipt_rejects_other_receipts_root() {
    let (mut claim, mut count, mut leaf, mut leaf_length, mut nodes) = case_receipt_typed_2();
    claim.receipts_root[0] ^= 1;
    let (claim, count, leaf, leaf_length, nodes) = (claim, count, leaf, leaf_length, nodes);
    let (claim, count, leaf, leaf_length, nodes) =
        black_box((claim, count, leaf, leaf_length, nodes));
    let result = receipt_summary(claim, count, leaf, leaf_length, nodes);
    let _ = result;
}

#[test(should_fail_with = "Node hash differs from its parent reference")]
fn receipt_rejects_other_transaction_index() {
    let (mut claim, mut count, mut leaf, mut leaf_length, mut nodes) = case_receipt_typed_2();
    claim.transaction_index ^= 1;
    let (claim, count, leaf, leaf_length, nodes) = (claim, count, leaf, leaf_length, nodes);
    let (claim, count, leaf, leaf_length, nodes) =
        black_box((claim, count, leaf, leaf_length, nodes));
    let result = receipt_summary(claim, count, leaf, leaf_length, nodes);
    let _ = result;
}

#[test(should_fail_with = "Receipt type differs from the claim")]
fn receipt_rejects_other_receipt_type() {
    let (mut claim, mut count, mut leaf, mut leaf_length, mut nodes) = case_receipt_typed_2();
    claim.receipt_type ^= 1;
    let (claim, count, leaf, leaf_length, nodes) = (claim, count, leaf, leaf_length, nodes);
    let (claim, count, leaf, leaf_length, nodes) =
        black_box((claim, count, leaf, leaf_length, nodes));
    let result = receipt_summary(claim, count, leaf, leaf_length, nodes);
    let _ = result;
}

#[test(should_fail_with = "Receipt outcome kind differs from the claim")]
fn receipt_rejects_other_has_post_state() {
    let (mut claim, mut count, mut leaf, mut leaf_length, mut nodes) = case_receipt_typed_2();
    claim.has_post_state = !claim.has_post_state;
    let (claim, count, leaf, leaf_length, nodes) = (claim, count, leaf, leaf_length, nodes);
    let (claim, count, leaf, leaf_length, nodes) =
        black_box((claim, count, leaf, leaf_length, nodes));
    let result = receipt_summary(claim, count, leaf, leaf_length, nodes);
    let _ = result;
}

#[test(should_fail_with = "Receipt status differs from the claim")]
fn receipt_rejects_other_status() {
    let (mut claim, mut count, mut leaf, mut leaf_length, mut nodes) = case_receipt_typed_2();
    claim.status = !claim.status;
    let (claim, count, leaf, leaf_length, nodes) = (claim, count, leaf, leaf_length, nodes);
    let (claim, count, leaf, leaf_length, nodes) =
        black_box((claim, count, leaf, leaf_length, nodes));
    let result = receipt_summary(claim, count, leaf, leaf_length, nodes);
    let _ = result;
}

#[test(should_fail_with = "Receipt post-state differs from the claim")]
fn receipt_rejects_other_post_state() {
    let (mut claim, mut count, mut leaf, mut leaf_length, mut nodes) = case_receipt_typed_2();
    claim.post_state[0] ^= 1;
    let (claim, count, leaf, leaf_length, nodes) = (claim, count, leaf, leaf_length, nodes);
    let (claim, count, leaf, leaf_length, nodes) =
        black_box((claim, count, leaf, leaf_length, nodes));
    let result = receipt_summary(claim, count, leaf, leaf_length, nodes);
    let _ = result;
}

#[test(should_fail_with = "Receipt gas differs from the claim")]
fn receipt_rejects_other_cumulative_gas_used() {
    let (mut claim, mut count, mut leaf, mut leaf_length, mut nodes) = case_receipt_typed_2();
    claim.cumulative_gas_used ^= 1;
    let (claim, count, leaf, leaf_length, nodes) = (claim, count, leaf, leaf_length, nodes);
    let (claim, count, leaf, leaf_length, nodes) =
        black_box((claim, count, leaf, leaf_length, nodes));
    let result = receipt_summary(claim, count, leaf, leaf_length, nodes);
    let _ = result;
}

#[test(should_fail_with = "Node count exceeds capacity")]
fn receipt_rejects_count_above_capacity() {
    let (mut claim, mut count, mut leaf, mut leaf_length, mut nodes) = case_receipt_typed_2();
    count = 5;
    let (claim, count, leaf, leaf_length, nodes) = (claim, count, leaf, leaf_length, nodes);
    let (claim, count, leaf, leaf_length, nodes) =
        black_box((claim, count, leaf, leaf_length, nodes));
    let result = receipt_summary(claim, count, leaf, leaf_length, nodes);
    let _ = result;
}

#[test(should_fail_with = "Receipt leaf hash differs from its parent reference")]
fn receipt_rejects_skipped_path() {
    let (mut claim, mut count, mut leaf, mut leaf_length, mut nodes) = case_receipt_typed_2();
    count = 0;
    let (claim, count, leaf, leaf_length, nodes) = (claim, count, leaf, leaf_length, nodes);
    let (claim, count, leaf, leaf_length, nodes) =
        black_box((claim, count, leaf, leaf_length, nodes));
    let result = receipt_summary(claim, count, leaf, leaf_length, nodes);
    let _ = result;
}

#[test(should_fail_with = "Receipt leaf length exceeds capacity")]
fn receipt_rejects_leaf_length_above_capacity() {
    let (mut claim, mut count, mut leaf, mut leaf_length, mut nodes) = case_receipt_typed_2();
    leaf_length = 1025;
    let (claim, count, leaf, leaf_length, nodes) = (claim, count, leaf, leaf_length, nodes);
    let (claim, count, leaf, leaf_length, nodes) =
        black_box((claim, count, leaf, leaf_length, nodes));
    let result = receipt_summary(claim, count, leaf, leaf_length, nodes);
    let _ = result;
}

#[test(should_fail_with = "Receipt leaf hash differs from its parent reference")]
fn receipt_rejects_truncated_leaf() {
    let (mut claim, mut count, mut leaf, mut leaf_length, mut nodes) = case_receipt_typed_2();
    leaf_length -= 1;
    let (claim, count, leaf, leaf_length, nodes) = (claim, count, leaf, leaf_length, nodes);
    let (claim, count, leaf, leaf_length, nodes) =
        black_box((claim, count, leaf, leaf_length, nodes));
    let result = receipt_summary(claim, count, leaf, leaf_length, nodes);
    let _ = result;
}

#[test(should_fail_with = "Receipt leaf hash differs from its parent reference")]
fn receipt_rejects_changed_leaf() {
    let (mut claim, mut count, mut leaf, mut leaf_length, mut nodes) = case_receipt_typed_2();
    leaf[10] ^= 1;
    let (claim, count, leaf, leaf_length, nodes) = (claim, count, leaf, leaf_length, nodes);
    let (claim, count, leaf, leaf_length, nodes) =
        black_box((claim, count, leaf, leaf_length, nodes));
    let result = receipt_summary(claim, count, leaf, leaf_length, nodes);
    let _ = result;
}

#[test(should_fail_with = "Node hash differs from its parent reference")]
fn receipt_rejects_changed_node() {
    let (mut claim, mut count, mut leaf, mut leaf_length, mut nodes) = case_receipt_typed_2();
    nodes[0].bytes[10] ^= 1;
    let (claim, count, leaf, leaf_length, nodes) = (claim, count, leaf, leaf_length, nodes);
    let (claim, count, leaf, leaf_length, nodes) =
        black_box((claim, count, leaf, leaf_length, nodes));
    let result = receipt_summary(claim, count, leaf, leaf_length, nodes);
    let _ = result;
}

#[test]
fn receipt_ignores_padding() {
    let (mut claim, mut count, mut leaf, mut leaf_length, mut nodes) = case_receipt_typed_2();
    leaf[1023] = 255;
    nodes[3] = EncodedNode { bytes: [255; 532], length: 4294967295, is_extension: true };
    let (claim, count, leaf, leaf_length, nodes) = (claim, count, leaf, leaf_length, nodes);
    let (claim, count, leaf, leaf_length, nodes) =
        black_box((claim, count, leaf, leaf_length, nodes));
    let result = receipt_summary(claim, count, leaf, leaf_length, nodes);
    let _ = result;
}

