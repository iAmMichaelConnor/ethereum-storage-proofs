#[test]
fn event_empty_event() {
    let (claim, count, leaf, leaf_length, nodes, data) = case_event_empty_event();
    let (claim, count, leaf, leaf_length, nodes, data) =
        black_box((claim, count, leaf, leaf_length, nodes, data));
    let result = event(claim, count, leaf, leaf_length, nodes, data);
    let _ = result;
}

#[test(should_fail_with = "Nonzero unused topic")]
fn event_rejects_unused_topic() {
    let (mut claim, mut count, mut leaf, mut leaf_length, mut nodes, mut data) =
        case_event_empty_event();
    claim.topics[3][31] = 255;
    let (claim, count, leaf, leaf_length, nodes, data) =
        (claim, count, leaf, leaf_length, nodes, data);
    let (claim, count, leaf, leaf_length, nodes, data) =
        black_box((claim, count, leaf, leaf_length, nodes, data));
    let result = event(claim, count, leaf, leaf_length, nodes, data);
    let _ = result;
}

#[test(should_fail_with = "Nonzero data padding")]
fn event_rejects_data_padding() {
    let (mut claim, mut count, mut leaf, mut leaf_length, mut nodes, mut data) =
        case_event_empty_event();
    data[255] = 255;
    let (claim, count, leaf, leaf_length, nodes, data) =
        (claim, count, leaf, leaf_length, nodes, data);
    let (claim, count, leaf, leaf_length, nodes, data) =
        black_box((claim, count, leaf, leaf_length, nodes, data));
    let result = event(claim, count, leaf, leaf_length, nodes, data);
    let _ = result;
}

