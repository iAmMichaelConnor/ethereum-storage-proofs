#[test(should_fail_with = "Matching path is not an absence proof")]
fn storage_zero_leaf_rejects_slot_key_31_low() {
    let (mut claim, mut count, mut terminal, mut terminal_length, mut kind, mut nodes) =
        case_storage_zero_leaf();
    claim.slot_key[31] ^= 1;
