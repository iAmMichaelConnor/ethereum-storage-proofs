        (claim, count, terminal, terminal_length, kind, nodes);
    let (claim, count, terminal, terminal_length, kind, nodes) =
        black_box((claim, count, terminal, terminal_length, kind, nodes));
    let result = storage_zero(claim, count, terminal, terminal_length, kind, nodes);
    let _ = result;
}

