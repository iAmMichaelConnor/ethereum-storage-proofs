#[test]
fn storage_zero_branch() {
    let (claim, count, terminal, terminal_length, kind, nodes) = case_storage_zero_branch();
    let (claim, count, terminal, terminal_length, kind, nodes) =
        black_box((claim, count, terminal, terminal_length, kind, nodes));
    let result = storage_zero(claim, count, terminal, terminal_length, kind, nodes);
    let _ = result;
}

#[test(should_fail_with = "Terminal hash differs from its parent reference")]
fn storage_zero_branch_rejects_storage_root_0_low() {
    let (mut claim, mut count, mut terminal, mut terminal_length, mut kind, mut nodes) =
        case_storage_zero_branch();
    claim.storage_root[0] ^= 1;
    let (claim, count, terminal, terminal_length, kind, nodes) =
        (claim, count, terminal, terminal_length, kind, nodes);
    let (claim, count, terminal, terminal_length, kind, nodes) =
        black_box((claim, count, terminal, terminal_length, kind, nodes));
    let result = storage_zero(claim, count, terminal, terminal_length, kind, nodes);
    let _ = result;
}

