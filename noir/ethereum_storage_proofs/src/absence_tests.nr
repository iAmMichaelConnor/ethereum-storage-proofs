#[test]
fn account_absent_account_leaf() {
    let (claim, count, terminal, terminal_length, kind, nodes) = case_account_absent_account_leaf();
    let (claim, count, terminal, terminal_length, kind, nodes) =
        black_box((claim, count, terminal, terminal_length, kind, nodes));
    let result = account_absent(claim, count, terminal, terminal_length, kind, nodes);
    let _ = result;
}

#[test(should_fail_with = "Terminal hash differs from its parent reference")]
fn account_absent_account_leaf_rejects_state_root_0_low() {
    let (mut claim, mut count, mut terminal, mut terminal_length, mut kind, mut nodes) =
        case_account_absent_account_leaf();
    claim.state_root[0] ^= 1;
    let (claim, count, terminal, terminal_length, kind, nodes) =
        (claim, count, terminal, terminal_length, kind, nodes);
    let (claim, count, terminal, terminal_length, kind, nodes) =
        black_box((claim, count, terminal, terminal_length, kind, nodes));
    let result = account_absent(claim, count, terminal, terminal_length, kind, nodes);
    let _ = result;
}

#[test(should_fail_with = "Terminal hash differs from its parent reference")]
fn account_absent_account_leaf_rejects_state_root_0_high() {
    let (mut claim, mut count, mut terminal, mut terminal_length, mut kind, mut nodes) =
        case_account_absent_account_leaf();
    claim.state_root[0] ^= 0x8000000000000000;
    let (claim, count, terminal, terminal_length, kind, nodes) =
        (claim, count, terminal, terminal_length, kind, nodes);
    let (claim, count, terminal, terminal_length, kind, nodes) =
        black_box((claim, count, terminal, terminal_length, kind, nodes));
    let result = account_absent(claim, count, terminal, terminal_length, kind, nodes);
    let _ = result;
}

