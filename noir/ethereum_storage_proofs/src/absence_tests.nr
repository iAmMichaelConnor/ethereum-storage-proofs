    let (mut claim, mut count, mut terminal, mut terminal_length, mut kind, mut nodes, mut account, mut account_count, mut account_nodes) =
        case_l1_zero_leaf();
    claim.slot_key[14] ^= 0x80;
    let (claim, count, terminal, terminal_length, kind, nodes, account, account_count, account_nodes) = (
        claim, count, terminal, terminal_length, kind, nodes, account, account_count, account_nodes,
    );
    let (claim, count, terminal, terminal_length, kind, nodes, account, account_count, account_nodes) = black_box(
        (
            claim, count, terminal, terminal_length, kind, nodes, account, account_count,
            account_nodes,
        ),
    );
    let result = l1_zero(
        claim,
        count,
        terminal,
        terminal_length,
        kind,
        nodes,
        account,
        account_count,
        account_nodes,
    );
    let _ = result;
}

