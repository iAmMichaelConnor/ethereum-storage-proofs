unconstrained fn streaming_word<let N: u32>(prefix: [u8; N], word: u64) -> [u8; 32] {
    let mut h = KeccakHasher::new();
    for byte in prefix {
        h.add_byte(byte);
    }
    h.add_u64(word);
    h.add_byte(255);
    h.finish()
}

