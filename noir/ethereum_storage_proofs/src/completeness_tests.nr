#[test]
fn ssz_zero_depth_padded_and_equal_siblings() {
    // Safety: All test witnesses and hint results are checked against the independent oracle below.
    let (leaf, suffix) = unsafe { witness(([255_u8; 32], [[42_u8; 32]; 3])) };
    verify_branch_bounded(leaf, suffix, 0, 1, leaf);
    let root = hash_pair(leaf, leaf);
    verify_branch_bounded(leaf, [leaf], 1, 2, root);
    verify_branch_bounded(leaf, [leaf], 1, 3, root);
}

