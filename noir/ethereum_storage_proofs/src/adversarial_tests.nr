#[test]
fn padding_and_unused_nodes_do_not_change_claim() {
    let (root, key, value, mut nodes) = fixture();
    nodes[0].bytes[134] = 255;
    let bad: EncodedNode<135> = EncodedNode { bytes: [255; 135], length: 999, is_extension: false };
    verify_storage(root, key, value, [nodes[0], nodes[1], bad], 2);
}
#[test]
fn compose_different_byte_capacities() {
    let (root, key, value, nodes) = fixture();
    let key_hash = keccak256(key, 32);
    let cursor = verify_path_section([nodes[0]], 1, new_cursor(root), key_hash);
    let mut large: EncodedNode<532> =
        EncodedNode { bytes: [0; 532], length: nodes[1].length, is_extension: false };
    for i in 0..135 {
        large.bytes[i] = nodes[1].bytes[i];
    }
    let cursor = verify_path_section([large], 1, cursor, key_hash);
    verify_storage_leaf(cursor, key_hash, value);
}
#[test(should_fail_with = "Cursor is beyond the key")]
fn rejects_cursor_beyond_key() {
    let (_, key, _, nodes) = fixture();
    let _ = verify_path_section(
        nodes,
        0,
        Cursor::from_authenticated_parts([0; 4], 32, 65),
        key,
    );
}
