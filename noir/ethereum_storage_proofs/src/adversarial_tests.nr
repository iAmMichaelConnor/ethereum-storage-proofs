#[test(should_fail_with = "Node hash differs from its parent reference")]
fn rejects_wrong_root() {
    let (mut root, key, value, nodes) = fixture();
    let count = 2;
    root[0] = root[0] ^ 1;
    verify_storage(root, key, value, nodes, count);
}

#[test(should_fail_with = "Extension path differs from the key")]
fn rejects_wrong_slot() {
    let (root, mut key, value, nodes) = fixture();
    let count = 2;
    key[31] = key[31] ^ 1;
    verify_storage(root, key, value, nodes, count);
}

#[test(should_fail_with = "Node hash differs from its parent reference")]
fn rejects_wrong_value() {
    let (root, key, mut value, nodes) = fixture();
    let count = 2;
    value.value[31] = value.value[31] ^ 1;
    verify_storage(root, key, value, nodes, count);
}

