fn sections_route(
    root: [u64; 4],
    slot_key: [u8; 32],
    value: StorageSlot,
    nodes: [EncodedNode<66>; 3],
    count: u32,
) {
    assert(count > 0);
    let key = keccak256(slot_key, 32);
    let first = verify_path_section([nodes[0]], 1, new_cursor(root), key);
    let last = verify_path_section([nodes[1], nodes[2]], count - 1, first, key);
    verify_storage_leaf(last, key, value);
}

