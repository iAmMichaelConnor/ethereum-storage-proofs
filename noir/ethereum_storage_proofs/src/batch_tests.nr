#[test]
fn batch_embedded_leaves_and_duplicates() {
    let (root, slot_keys, values, nodes, node_count, paths) = case_inline();
    let (root, slot_keys, values, nodes, node_count, paths) =
        black_box((root, slot_keys, values, nodes, node_count, paths));
    let result = verify_storage_batch(root, slot_keys, values, nodes, node_count, paths);
    let _ = result;
}
