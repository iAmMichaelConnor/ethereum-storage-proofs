    let slot = StorageSlot {
        value: black_box([
            48, 100, 78, 114, 225, 49, 160, 41, 184, 80, 69, 182, 129, 129, 88, 93, 40, 51, 232, 72,
            121, 185, 112, 145, 67, 225, 245, 147, 240, 0, 0, 1,
        ]),
        value_length: black_box(32),
    };
    let a = Account {
        balance: slot.value,
        balance_length: slot.value_length,
        nonce: [0; 8],
        nonce_length: 0,
        address: [0; 20],
        storage_hash: [0; 4],
        code_hash: [0; 4],
