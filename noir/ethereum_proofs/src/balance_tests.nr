#[test(should_fail_with = "quantity exceeds native Field")]
fn account_rejects_balance_at_field_modulus() {
    let (state_root, address, account, account_nodes, account_count) = case_account_overflow();
    let (state_root, address, account, account_nodes, account_count) =
        black_box((state_root, address, account, account_nodes, account_count));
    let result = account_balance(state_root, address, account, account_nodes, account_count);
    let _ = result;
}

#[test(should_fail_with = "proof is for a different account")]
fn account_rejects_other_address() {
    let (mut state_root, mut address, mut account, mut account_nodes, mut account_count) =
        case_account_valid();
    address[0] ^= 1;
    let (state_root, address, account, account_nodes, account_count) =
        (state_root, address, account, account_nodes, account_count);
    let (state_root, address, account, account_nodes, account_count) =
        black_box((state_root, address, account, account_nodes, account_count));
    let result = account_balance(state_root, address, account, account_nodes, account_count);
    let _ = result;
}

#[test(should_fail_with = "Node hash differs from its parent reference")]
fn account_rejects_other_root() {
    let (mut state_root, mut address, mut account, mut account_nodes, mut account_count) =
        case_account_valid();
    state_root[0] ^= 1;
    let (state_root, address, account, account_nodes, account_count) =
        (state_root, address, account, account_nodes, account_count);
