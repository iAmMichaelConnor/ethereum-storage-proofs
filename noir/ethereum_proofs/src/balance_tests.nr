#[test]
fn account_balance_and_nonce() {
    let (state_root, address, account, account_nodes, account_count) = case_account_valid();
    let (state_root, address, account, account_nodes, account_count) =
        black_box((state_root, address, account, account_nodes, account_count));
    let result = account_balance(state_root, address, account, account_nodes, account_count);
    assert_eq(result, (1000000000000000000, 7));
}

#[test]
fn erc20_balance_of_holder() {
    let (state_root, token, holder, account, account_nodes, account_count, value, storage_nodes, storage_count) =
        case_token_valid();
    let (state_root, token, holder, account, account_nodes, account_count, value, storage_nodes, storage_count) = black_box(
        (
            state_root, token, holder, account, account_nodes, account_count, value, storage_nodes,
            storage_count,
        ),
    );
    let result = erc20_balance(
        state_root,
        token,
        holder,
        account,
        account_nodes,
        account_count,
        value,
        storage_nodes,
        storage_count,
    );
    assert_eq(result, 12345678901234567890);
}

