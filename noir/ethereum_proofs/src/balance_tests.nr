#[test(should_fail_with = "Nonzero balance padding")]
fn account_rejects_noncanonical_balance_padding() {
    let (mut state_root, mut address, mut account, mut account_nodes, mut account_count) =
        case_account_valid();
    account.balance[31] = 1;
    let (state_root, address, account, account_nodes, account_count) =
        (state_root, address, account, account_nodes, account_count);
    let (state_root, address, account, account_nodes, account_count) =
        black_box((state_root, address, account, account_nodes, account_count));
    let result = account_balance(state_root, address, account, account_nodes, account_count);
    let _ = result;
}

