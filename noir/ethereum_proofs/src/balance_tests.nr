#[test(should_fail_with = "quantity exceeds u128")]
fn erc20_rejects_balance_above_u128() {
    let (state_root, token, holder, account, account_nodes, account_count, value, storage_nodes, storage_count) =
        case_token_overflow();
    let (state_root, token, holder, account, account_nodes, account_count, value, storage_nodes, storage_count) = black_box(
        (
            state_root, token, holder, account, account_nodes, account_count, value, storage_nodes,
            storage_count,
        ),
    );
    let result = erc20_balance(
        state_root,
        token,
        holder,
        account,
        account_nodes,
        account_count,
        value,
        storage_nodes,
        storage_count,
    );
    let _ = result;
}

