#[test]
unconstrained fn mainnet_account_and_storage() {
    let (root, account, account_nodes, account_count, key, high, low, storage_nodes, storage_count)
         = mainnet();
    verify_account_and_storage(
        root,
        PublicAccount::from_fields(account),
        account_nodes,
        account_count,
        key,
        high,
        low,
        storage_nodes,
        storage_count,
    );
}

