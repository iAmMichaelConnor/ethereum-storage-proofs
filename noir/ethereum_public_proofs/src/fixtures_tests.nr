#[test(should_fail_with = "Node hash differs from its parent reference")]
unconstrained fn rejects_wrong_state_root() {
    let (root, account, account_nodes, account_count, key, high, low, storage_nodes, storage_count)
         = mainnet();
    let account = PublicAccount::from_fields(account);
    let mut root = root;
    root[0] = root[0] ^ 1;
    verify_account(root, account, account_nodes, account_count);
    let _ = (key, high, low, storage_nodes, storage_count);
}

#[test(should_fail_with = "Storage leaf differs from its parent reference")]
unconstrained fn rejects_wrong_storage_value() {
    let (root, account, account_nodes, account_count, key, high, low, storage_nodes, storage_count)
         = mainnet();
    let account = PublicAccount::from_fields(account);
    verify_storage(
        account.storage_hash,
        key,
        high,
        low + 1,
        storage_nodes,
        storage_count,
    );
    let _ = (root, account_nodes, account_count);
}

#[test(should_fail_with = "Zero storage value has no leaf")]
unconstrained fn rejects_zero_storage_value() {
    let (root, account, account_nodes, account_count, key, high, low, storage_nodes, storage_count)
         = mainnet();
    let account = PublicAccount::from_fields(account);
    verify_storage(
        account.storage_hash,
        key,
        0,
        0,
        storage_nodes,
        storage_count,
    );
    let _ = (root, account_nodes, account_count, high, low);
}

#[test(should_fail_with = "Account leaf differs from its parent reference")]
unconstrained fn rejects_wrong_balance() {
    let (root, account, account_nodes, account_count, key, high, low, storage_nodes, storage_count)
         = mainnet();
    let account = PublicAccount::from_fields(account);
    let mut account = account;
    account.balance_low += 1;
    verify_account(root, account, account_nodes, account_count);
    let _ = (key, high, low, storage_nodes, storage_count);
}

#[test(should_fail_with = "Account leaf differs from its parent reference")]
unconstrained fn rejects_wrong_nonce() {
    let (root, account, account_nodes, account_count, key, high, low, storage_nodes, storage_count)
         = mainnet();
    let account = PublicAccount::from_fields(account);
    let mut account = account;
    account.nonce += 1;
    verify_account(root, account, account_nodes, account_count);
    let _ = (key, high, low, storage_nodes, storage_count);
}

#[test(should_fail_with = "Path walked a different key")]
unconstrained fn rejects_leaf_for_other_address() {
    let (root, account, account_nodes, account_count, key, high, low, storage_nodes, storage_count)
         = mainnet();
    let account = PublicAccount::from_fields(account);
    let end = verify_path(root, account.key_hash(), account_nodes, account_count);
    let mut other = account;
    other.address += 1;
    verify_account_leaf(end, other);
    let _ = (key, high, low, storage_nodes, storage_count);
}

#[test(should_fail_with = "Path walked a different key")]
unconstrained fn rejects_leaf_for_other_slot() {
    let (root, account, account_nodes, account_count, key, high, low, storage_nodes, storage_count)
         = mainnet();
    let account = PublicAccount::from_fields(account);
    let key_hash = slot_key_hash(key);
    let end = verify_path(account.storage_hash, key_hash, storage_nodes, storage_count);
    let mut other = key_hash;
    other[3] = other[3] ^ 1;
    verify_storage_leaf(end, other, high, low);
    let _ = (root, account_nodes, account_count);
}

#[test(should_fail_with = "Storage leaf differs from its parent reference")]
unconstrained fn rejects_truncated_path() {
    let (root, account, account_nodes, account_count, key, high, low, storage_nodes, storage_count)
         = mainnet();
    let account = PublicAccount::from_fields(account);
    verify_storage(
        account.storage_hash,
        key,
        high,
        low,
        storage_nodes,
        storage_count - 1,
    );
    let _ = (root, account_nodes, account_count);
}

#[test(should_fail_with = "Node count exceeds capacity")]
unconstrained fn rejects_count_exceeds_capacity() {
    let (root, account, account_nodes, account_count, key, high, low, storage_nodes, storage_count)
         = mainnet();
    let account = PublicAccount::from_fields(account);
    verify_storage(account.storage_hash, key, high, low, storage_nodes, 9);
    let _ = (root, account_nodes, account_count, storage_count);
}

#[test(should_fail_with = "Node hash differs from its parent reference")]
unconstrained fn rejects_modified_sibling() {
    let (root, account, account_nodes, account_count, key, high, low, storage_nodes, storage_count)
         = mainnet();
    let account = PublicAccount::from_fields(account);
    let mut nodes = account_nodes;
    nodes[0][5] = nodes[0][5] + 1;
    verify_account(root, account, nodes, account_count);
    let _ = (key, high, low, storage_nodes, storage_count);
}

