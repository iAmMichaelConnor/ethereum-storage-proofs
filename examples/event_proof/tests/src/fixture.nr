//! Logs of independent EthereumJS receipt tries in synthetic pinned blocks; no chain has these blocks.
use event_proof_contract::{Block, EthereumLog, ProofNode};

/// The verifier time the block was pinned for.
pub global NOW: u64 = 4000000000;
/// The pinned block's time, two minutes before `NOW`.
pub global BLOCK_TIME: u64 = 3999999880;
/// A local development chain id.
pub global CHAIN_ID: u64 = 31337;

/// A proof node: `prefix` zero-padded to the node capacity.
fn node<let N: u32>(prefix: [u8; N], is_extension: bool) -> ProofNode {
    ProofNode { bytes: pad(prefix), length: N, is_extension }
}

/// An unused proof node.
fn empty_node() -> ProofNode {
    ProofNode { bytes: [0; 532], length: 0, is_extension: false }
}

/// `prefix` zero-padded to `M` bytes.
fn pad<let N: u32, let M: u32>(prefix: [u8; N]) -> [u8; M] {
    let mut out = [0; M];
    for i in 0..N {
        out[i] = prefix[i];
    }
    out
}

